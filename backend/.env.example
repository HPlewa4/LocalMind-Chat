# false uses local Ollama; true uses a Groq-hosted Llama model.
HOSTED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

MONGO_URI=mongodb://localhost:27017
MONGO_DB=localmind_chat

# Comma-separated origins are supported. Do not include a trailing slash.
FRONTEND_ORIGIN=http://localhost:3000,https://local-mind-chat.vercel.app
